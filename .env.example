# --- Database (Postgres) ---
# Local: the docker-compose database. Vercel: Neon (pooled URL for DATABASE_URL, direct URL for DIRECT_URL).
DATABASE_URL=postgresql://ugethnofish:localdevpassword@localhost:5432/ugethnofish
DIRECT_URL=postgresql://ugethnofish:localdevpassword@localhost:5432/ugethnofish

# --- Sessions ---
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-at-least-32-random-bytes

# --- First admin account (used only by `npm run db:seed`) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run

# --- Private S3-compatible object storage ---
# Local: MinIO from docker-compose.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION to the bucket's region.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ugethnofish-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Per-image limit checked by the server. Browsers compress photos to ~2 MB before sending;
# Vercel rejects any request body over 4.5 MB.
MAX_UPLOAD_MB=4
